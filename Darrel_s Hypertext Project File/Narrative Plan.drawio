        <mxCell id="4cd9yuj2vxOyTZg44lFt-6" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;THE ADVENTURES OF THE MULTIVERSE (DC)&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
